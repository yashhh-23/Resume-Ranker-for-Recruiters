# RRR Frontend — Environment Variables
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and never committed.

# Backend API base URL
VITE_API_URL=http://localhost:8000

# Demo passphrase for the hackathon PassphraseGate screen.
# This is the passphrase judges should enter on the login screen.
# Set this to whatever passphrase you want to use for the demo.
# (The value here is the hackathon demo value — change before production.)
VITE_DEMO_PASSPHRASE=hackathon2026
